# Copy this file to `.env.local` for local development.
# Never commit real secrets. Placeholders only.

# Public app URL (used by the client and CORS configuration in later steps)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Part 1 — database and realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication (Part 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional: bootstrap the first admin account (documented mechanism TBD in step 1.3+)
ADMIN_BOOTSTRAP_EMAIL=
