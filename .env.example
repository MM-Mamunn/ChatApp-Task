# Copy to `.env` at the repository root for local development.
# Never commit real credentials.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL (Drizzle) — Session pooler or direct connection string
DATABASE_URL=

# Supabase client (realtime / client SDK — later steps)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication (later steps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional first admin bootstrap
ADMIN_BOOTSTRAP_EMAIL=
